POSTGRES_DB=notification_db
POSTGRES_USER=notification_user
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://notification_user:change-me@127.0.0.1:5437/notification_db

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Email. For local development run Mailpit (see docker-compose.yml): it catches
# every message and shows it at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none        # none | starttls | ssl
SMTP_FROM=clinic@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional (defaults shown). RETRY_DELAY_MS is baked into the retry queue when it is
# first declared: to change it, delete that queue in RabbitMQ first.
# MAX_ATTEMPTS=3
# RETRY_DELAY_MS=10000
# QUEUE_NAME=notification.appointments
