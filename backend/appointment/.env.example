POSTGRES_DB=appointment_db
POSTGRES_USER=appointment_user
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://appointment_user:change-me@127.0.0.1:5436/appointment_db

# Public keys of the auth service (no secret needed).
AUTH_JWKS_URL=http://localhost:8003/.well-known/jwks.json
JWT_ISSUER=auth-service
JWT_AUDIENCE=clinic-platform

# Services this one asks about clinics, doctors and patients.
CLINIC_SERVICE_URL=http://localhost:8002
DOCTOR_SERVICE_URL=http://localhost:8000
PATIENT_SERVICE_URL=http://localhost:8001

# Length of every appointment slot (minutes). Changing it later needs care:
# existing appointments keep their old length.
SLOT_MINUTES=30

# RabbitMQ: where the outbox relay publishes events.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
