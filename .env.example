# Copy to .env and change the passwords. .env is git-ignored.

# --- Databases (one per service) ---
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=change-me

CLINIC_POSTGRES_DB=clinic_db
CLINIC_POSTGRES_USER=clinic_user
CLINIC_POSTGRES_PASSWORD=change-me

DOCTOR_POSTGRES_DB=doctor_db
DOCTOR_POSTGRES_USER=doctor_user
DOCTOR_POSTGRES_PASSWORD=change-me

PATIENT_POSTGRES_DB=patient_db
PATIENT_POSTGRES_USER=patient_user
PATIENT_POSTGRES_PASSWORD=change-me

APPOINTMENT_POSTGRES_DB=appointment_db
APPOINTMENT_POSTGRES_USER=appointment_user
APPOINTMENT_POSTGRES_PASSWORD=change-me

NOTIFICATION_POSTGRES_DB=notification_db
NOTIFICATION_POSTGRES_USER=notification_user
NOTIFICATION_POSTGRES_PASSWORD=change-me

# --- Message broker ---
# (RabbitMQ's built-in guest account only works from localhost, so make a real one.)
RABBITMQ_USER=clinic
RABBITMQ_PASSWORD=change-me
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MS=10000

# --- Tokens ---
# There is no shared JWT secret any more: auth signs with a private key
# (backend/auth/keys/private.pem) and other services use its public key.
JWT_ISSUER=auth-service
JWT_AUDIENCE=clinic-platform
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
